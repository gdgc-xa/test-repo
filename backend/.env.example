# Copy to .env, fill in, then:  chmod 600 .env
# NEVER commit .env. This repository is public.

# --- Database (read-only user) ---
DB_HOST=campus-mysql
DB_PORT=3306
DB_NAME=campus_compass
DB_USER=campus_api
# Copied from API_DB_PASSWORD in /opt/campus-compass/.env by a command
# (see README) so it is never shown on screen.
DB_PASSWORD=

# --- Who may read the API from a browser ---
# Comma-separated. Exact origins, "http://localhost:*" for any local
# port, or "https://*.name.pages.dev" for any one subdomain.
# Moving the site (e.g. to Cloudflare Pages) = add its origin here,
# then: docker compose up -d
ALLOWED_ORIGINS=https://gdgc-xa.github.io,http://localhost:*

# --- Tuning ---
# Seconds each answer is kept in memory (5–10).
CACHE_SECONDS=10
# Requests per minute per IP. Generous: a campus Wi-Fi network can put
# hundreds of students behind one IP.
RATE_LIMIT_PER_MINUTE=600
# After this many seconds without a sync, responses say sync.stale = true.
STALE_SECONDS=180

# --- Traefik (HTTPS) ---
# Copy these from n8n's labels; see README, "Find Traefik's names".
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=
