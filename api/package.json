{
  "name": "campus-compass-api",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only API between the Campus Compass MySQL database and the website.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/unit.test.js",
    "test:db": "node test/setup-test-db.js && node --test --test-concurrency=1 test/unit.test.js test/db.test.js",
    "test:db:stop": "docker rm -f campus-api-test-db"
  },
  "license": "MIT",
  "dependencies": {
    "express": "5.3.0",
    "mysql2": "3.24.6"
  }
}
